generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Merchant {
  id        String    @id @default(cuid())
  name      String
  storeUrl  String
  createdAt DateTime  @default(now())
  products  Product[]
  user      User?
}

model Product {
  id             String          @id @default(cuid())
  merchantId     String
  merchant       Merchant        @relation(fields: [merchantId], references: [id])
  title          String
  sku            String
  currentPrice   Int
  cogs           Int?
  category       String
  estUnits       Int?
  createdAt      DateTime        @default(now())
  recommendation Recommendation?
}

model Recommendation {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id])
  action      String
  deltaPct    Float
  rulesJson   String
  phrasing    String
  generatedAt DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  merchantId   String    @unique
  merchant     Merchant  @relation(fields: [merchantId], references: [id])
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
