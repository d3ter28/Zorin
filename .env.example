# Neon Postgres connection string (get from neon.tech → your project → Connection Details)
# Use the "pooled" connection string (starts with postgres://)
DATABASE_URL="postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 32-byte key for encrypting Shopify access tokens (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOPIFY_ENCRYPTION_KEY=""
